# =============================================================================
# Multimodal AI Chatbot - Environment Configuration
# Copy this file to .env and fill in your credentials before running.
# NEVER commit your actual .env file to version control.
# =============================================================================

# Application
APP_NAME="Multimodal AI Assistant"
APP_ENV="development"
DEBUG=false
API_HOST="127.0.0.1"
API_PORT=8000
BACKEND_URL="http://127.0.0.1:8000"

# Backend API Key Guard (optional shared key between Streamlit and FastAPI; leave blank to disable in local dev)
INTERNAL_API_KEY=""

# MySQL Database Configuration
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="multimodal_chatbot"
# Optional full override URL (e.g. mysql+pymysql://user:pass@host:3306/db)
DATABASE_URL=""

# AI Provider Selection ("gemini" | "huggingface")
AI_PROVIDER="gemini"

# Google Gemini API (Get a free key from https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-3.5-flash-lite"
GEMINI_VISION_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Hugging Face Configuration (Alternative Provider)
HF_TOKEN=""
HF_INFERENCE_MODE="api"
HF_TIMEOUT_SECONDS=90

# Configurable Hugging Face Model IDs
HF_CHAT_MODEL="meta-llama/Llama-3.1-8B-Instruct"
HF_VISION_MODEL="Qwen/Qwen3-VL-8B-Instruct"
HF_ASR_MODEL="openai/whisper-large-v3-turbo"
HF_TTS_MODEL="facebook/mms-tts-eng"
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Text-to-Speech Fallback ("gtts" | "pyttsx3" | "none")
TTS_FALLBACK_ENGINE="pyttsx3"

# RAG Settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15

# Upload & Security Guardrails
MAX_TEXT_LENGTH=4000
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=20
MAX_HISTORY_MESSAGES=12
RATE_LIMIT_PER_MINUTE=30
